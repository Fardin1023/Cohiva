# Cohiva web app on Vercel
# Add these in Vercel Dashboard -> Project -> Settings -> Environment Variables.
# Do not commit real secret values.

NODE_ENV=production

# MongoDB Atlas
MONGODB_URI=mongodb+srv://USER:PASSWORD@YOUR_CLUSTER.mongodb.net/cohiva?retryWrites=true&w=majority

# Public Cohiva web origin. Your *.vercel.app production URL is valid if you do not own a custom domain.
COHIVA_APP_URL=https://your-project.vercel.app

# Must match the secret configured on the external Cohiva RTC server.
COHIVA_RTC_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# External mediasoup signaling/control server. Both must use the same RTC host.
COHIVA_RTC_PUBLIC_URL=wss://rtc.example.com/rtc
COHIVA_RTC_INTERNAL_URL=https://rtc.example.com

# Vercel Blob recording backend. Create a PRIVATE Blob store connected to this Vercel project.
COHIVA_RECORDING_STORAGE=vercel-blob
NEXT_PUBLIC_COHIVA_RECORDING_STORAGE=vercel-blob

# Vercel Blob credentials are normally provisioned by Vercel when the private store is connected.
# With current Private Blob/OIDC deployments you should not hard-code a long-lived token.
# BLOB_READ_WRITE_TOKEN=  # only if your Blob setup explicitly gives you/needs one

# Production password reset email
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Cohiva <no-reply@example.com>"
