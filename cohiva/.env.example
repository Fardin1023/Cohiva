# Local development example. Copy to .env.local and fill your own values.
MONGODB_URI=mongodb://127.0.0.1:27017/cohiva
COHIVA_APP_URL=http://localhost:3000

# Use a long random value (32+ characters).
COHIVA_RTC_SECRET=replace-with-a-long-random-secret
COHIVA_RTC_PORT=4100
COHIVA_RTC_MEDIA_PORT=4101
COHIVA_RTC_LISTEN_IP=0.0.0.0
COHIVA_RTC_ANNOUNCED_ADDRESS=127.0.0.1
COHIVA_RTC_INTERNAL_URL=http://127.0.0.1:4100
COHIVA_RTC_PUBLIC_URL=ws://127.0.0.1:4100/rtc
COHIVA_RTC_ALLOWED_ORIGINS=http://localhost:3000

# Local recordings. Production should use a persistent mounted directory.
COHIVA_RECORDINGS_DIR=./storage/recordings

# Optional SMTP. If omitted in development, Cohiva exposes a development-only reset URL.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Cohiva <no-reply@example.com>"

# Optional TURN fallback. Leave empty locally if direct media works.
COHIVA_TURN_URLS=
COHIVA_TURN_SECRET=
COHIVA_TURN_CREDENTIAL_TTL_SECONDS=3600
COHIVA_RTC_ICE_TRANSPORT_POLICY=all

# Optional comma-separated development hosts accepted by Next dev.
COHIVA_DEV_ALLOWED_ORIGINS=192.168.0.102
