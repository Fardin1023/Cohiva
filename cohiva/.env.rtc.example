# Cohiva RTC + TURN server environment (external Linux VPS/server)
NODE_ENV=production

# Same MongoDB used by the Vercel web app.
MONGODB_URI=mongodb+srv://USER:PASSWORD@YOUR_CLUSTER.mongodb.net/cohiva?retryWrites=true&w=majority

# Public DNS name and IPv4 address of this RTC server.
COHIVA_RTC_DOMAIN=rtc.example.com
COHIVA_PUBLIC_IP=203.0.113.10

# Must be IDENTICAL to COHIVA_RTC_SECRET in Vercel.
COHIVA_RTC_SECRET=replace-with-a-long-random-secret-at-least-32-characters

COHIVA_RTC_PORT=4100
COHIVA_RTC_MEDIA_PORT=4101
COHIVA_RTC_LISTEN_IP=0.0.0.0
COHIVA_RTC_ANNOUNCED_ADDRESS=203.0.113.10

# Exact Vercel production origin(s) allowed to open the WebSocket.
# Multiple origins can be comma-separated.
COHIVA_RTC_ALLOWED_ORIGINS=https://your-project.vercel.app

# TURN fallback. Keep this secret DIFFERENT from COHIVA_RTC_SECRET.
COHIVA_TURN_URLS=turn:rtc.example.com:3478?transport=udp,turn:rtc.example.com:3478?transport=tcp
COHIVA_TURN_SECRET=replace-with-a-second-long-random-secret-at-least-32-characters
COHIVA_TURN_CREDENTIAL_TTL_SECONDS=3600
COHIVA_RTC_ICE_TRANSPORT_POLICY=all
